{
  "info": {
    "name": "EMS Backend API",
    "description": "Employee Management System backend for PT Nusantara Digital. See EMS-BACKEND-PLAN.md and docs/superpowers/specs/*.md in the repo for full design and contract details.\n\nQuick start:\n1. Set {{baseUrl}} if you're not using the default (http://localhost:3000, matching `docker compose up --build`'s default port).\n2. Run \"Login\" once -- its test script auto-populates {{token}} for every other request.\n3. Run \"Create Employee\" once if you want {{employeeId}} auto-populated for Get/Update/Delete.\n4. Run \"Upload CSV\" once if you want {{jobId}} auto-populated for \"Import Status\".\n\nEvery request below has at least one saved example response captured from a real, live run of this backend (not hand-written guesses) -- click a request's \"Examples\" dropdown in Postman to see them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "e1e6b2b0-0a4a-4b6a-8b0a-ems-backend-collection"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "employeeId", "value": "", "type": "string" },
    { "key": "jobId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('token', body.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@nusantaradigital.test\",\n  \"password\": \"ChangeMe123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Admin login. On success, populates {{token}} for every other request via the test script above. Credentials are the seeded admin's -- see backend/.env.example's ADMIN_EMAIL/ADMIN_PASSWORD (or whatever you overrode them to)."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@nusantaradigital.test\",\n  \"password\": \"ChangeMe123!\"\n}" },
                "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
              },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI5YjQxZjEyNS03ZGExLTQxNjMtYjBlMy1mZWFmZDIwZDI2ZmMiLCJlbWFpbCI6ImFkbWluQG51c2FudGFyYWRpZ2l0YWwudGVzdCIsImlhdCI6MTc4NzIwOTIyNSwiZXhwIjoxNzg3MjEyODI1fQ.sYQQu-4BS65ZeVLsflDRNjlZoDwUESTKauASV8vE4X4\",\n  \"expiresIn\": \"1h\"\n}"
            },
            {
              "name": "401 Invalid credentials",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@nusantaradigital.test\",\n  \"password\": \"wrong\"\n}" },
                "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
              },
              "status": "Unauthorized",
              "code": 401,
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"statusCode\": 401,\n  \"timestamp\": \"2026-08-20T07:00:25.566Z\",\n  \"path\": \"/auth/login\",\n  \"message\": \"Invalid credentials\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Employees",
      "item": [
        {
          "name": "List Employees",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/employees?page=1&limit=20&search=&sortBy=createdAt&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["employees"],
              "query": [
                { "key": "page", "value": "1", "description": "1-indexed. Default 1." },
                { "key": "limit", "value": "20", "description": "Page size, default 50, capped at 500." },
                { "key": "search", "value": "", "description": "Case-insensitive substring match against name OR position. Leave empty to disable." },
                { "key": "sortBy", "value": "createdAt", "description": "One of: name | age | position | salary | createdAt. Default createdAt." },
                { "key": "sortOrder", "value": "desc", "description": "asc | desc. Default desc." }
              ]
            },
            "description": "Server-side paginated/searched/sorted employee list. Response shape: { data: Employee[], total, page, limit }."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                "url": { "raw": "{{baseUrl}}/employees?page=1&limit=3&sortBy=createdAt&sortOrder=desc", "host": ["{{baseUrl}}"], "path": ["employees"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "3" }, { "key": "sortBy", "value": "createdAt" }, { "key": "sortOrder", "value": "desc" }] }
              },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"data\": [\n    {\n      \"id\": \"22a55bcd-0399-461e-8939-d05657c78a96\",\n      \"name\": \"Example Employee\",\n      \"age\": 29,\n      \"position\": \"Senior Software Engineer\",\n      \"salary\": \"16000000\",\n      \"createdAt\": \"2026-08-20T07:01:08.750Z\",\n      \"updatedAt\": \"2026-08-20T07:01:08.791Z\"\n    },\n    {\n      \"id\": \"824f68b5-aa54-41c9-96f7-7c4581ae1cdb\",\n      \"name\": \"Maria Tan\",\n      \"age\": 28,\n      \"position\": \"QA Engineer\",\n      \"salary\": \"9000000\",\n      \"createdAt\": \"2026-08-20T06:47:13.297Z\",\n      \"updatedAt\": \"2026-08-20T06:47:13.297Z\"\n    },\n    {\n      \"id\": \"bcbb21bc-2317-4afa-895d-9c0e0764adc2\",\n      \"name\": \"Budi Santoso\",\n      \"age\": 35,\n      \"position\": \"Product Manager\",\n      \"salary\": \"22000000\",\n      \"createdAt\": \"2026-08-20T06:47:13.297Z\",\n      \"updatedAt\": \"2026-08-20T06:47:13.297Z\"\n    }\n  ],\n  \"total\": 23,\n  \"page\": 1,\n  \"limit\": 3\n}\n\n// Note: `salary` round-trips as a numeric STRING (Prisma Decimal has no custom JSON\n// serializer in this codebase) -- the frontend normalizes it to a number on read.\n// See backend/EMS-BACKEND-PLAN.md and frontend/docs/superpowers/AUDIT.md for context."
            },
            {
              "name": "401 Unauthorized (no token)",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": { "raw": "{{baseUrl}}/employees", "host": ["{{baseUrl}}"], "path": ["employees"] }
              },
              "status": "Unauthorized",
              "code": 401,
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"statusCode\": 401,\n  \"timestamp\": \"2026-08-20T07:00:25.633Z\",\n  \"path\": \"/employees\",\n  \"message\": \"Unauthorized\"\n}"
            }
          ]
        },
        {
          "name": "Get Employee By Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/employees/{{employeeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["employees", "{{employeeId}}"]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                "url": { "raw": "{{baseUrl}}/employees/de4accbc-1767-4632-b75b-938bcf11bfa3", "host": ["{{baseUrl}}"], "path": ["employees", "de4accbc-1767-4632-b75b-938bcf11bfa3"] }
              },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"id\": \"de4accbc-1767-4632-b75b-938bcf11bfa3\",\n  \"name\": \"John Doe\",\n  \"age\": 30,\n  \"position\": \"Software Engineer\",\n  \"salary\": \"12000000\",\n  \"createdAt\": \"2026-08-20T06:47:13.297Z\",\n  \"updatedAt\": \"2026-08-20T06:47:13.297Z\"\n}"
            },
            {
              "name": "404 Not Found",
              "originalRequest": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                "url": { "raw": "{{baseUrl}}/employees/00000000-0000-0000-0000-000000000000", "host": ["{{baseUrl}}"], "path": ["employees", "00000000-0000-0000-0000-000000000000"] }
              },
              "status": "Not Found",
              "code": 404,
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"statusCode\": 404,\n  \"timestamp\": \"2026-08-20T06:46:22.143Z\",\n  \"path\": \"/employees/00000000-0000-0000-0000-000000000000\",\n  \"message\": \"Employee 00000000-0000-0000-0000-000000000000 not found\"\n}"
            }
          ]
        },
        {
          "name": "Create Employee",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('employeeId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Siti Nurhaliza\",\n  \"age\": 28,\n  \"position\": \"Software Engineer\",\n  \"salary\": 12000000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": ["{{baseUrl}}"],
              "path": ["employees"]
            },
            "description": "Creates an employee. name: non-empty string. age: integer 16-100. position: non-empty string. salary: number >= 0. Also enqueues a BullMQ 'employee-created' job -- the worker validates it, then pushes an `employee.created` event on GET /notifications/stream."
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"Example Employee\",\n  \"age\": 28,\n  \"position\": \"Software Engineer\",\n  \"salary\": 12000000\n}" },
                "url": { "raw": "{{baseUrl}}/employees", "host": ["{{baseUrl}}"], "path": ["employees"] }
              },
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"id\": \"22a55bcd-0399-461e-8939-d05657c78a96\",\n  \"name\": \"Example Employee\",\n  \"age\": 28,\n  \"position\": \"Software Engineer\",\n  \"salary\": \"12000000\",\n  \"createdAt\": \"2026-08-20T07:01:08.750Z\",\n  \"updatedAt\": \"2026-08-20T07:01:08.750Z\"\n}"
            },
            {
              "name": "400 Validation error",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"\"\n}" },
                "url": { "raw": "{{baseUrl}}/employees", "host": ["{{baseUrl}}"], "path": ["employees"] }
              },
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"statusCode\": 400,\n  \"timestamp\": \"2026-08-20T07:00:25.649Z\",\n  \"path\": \"/employees\",\n  \"message\": [\n    \"name must be longer than or equal to 1 characters\",\n    \"age must not be greater than 100\",\n    \"age must not be less than 16\",\n    \"age must be an integer number\",\n    \"position must be longer than or equal to 1 characters\",\n    \"position must be a string\",\n    \"salary must not be less than 0\",\n    \"salary must be a number conforming to the specified constraints\"\n  ]\n}"
            }
          ]
        },
        {
          "name": "Update Employee",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"salary\": 16000000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/employees/{{employeeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["employees", "{{employeeId}}"]
            },
            "description": "All fields are optional (partial update) -- send just the fields you want to change, e.g. { \"salary\": 16000000 }, or the full shape like Create Employee. The :id route param (never a body field) is always what gets updated -- a client can't retarget a different row by putting an `id` in the body."
          },
          "response": [
            {
              "name": "200 OK (partial body)",
              "originalRequest": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"salary\": 16000000\n}" },
                "url": { "raw": "{{baseUrl}}/employees/22a55bcd-0399-461e-8939-d05657c78a96", "host": ["{{baseUrl}}"], "path": ["employees", "22a55bcd-0399-461e-8939-d05657c78a96"] }
              },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"id\": \"22a55bcd-0399-461e-8939-d05657c78a96\",\n  \"name\": \"Example Employee\",\n  \"age\": 29,\n  \"position\": \"Senior Software Engineer\",\n  \"salary\": \"16000000\",\n  \"createdAt\": \"2026-08-20T07:01:08.750Z\",\n  \"updatedAt\": \"2026-08-20T07:01:08.791Z\"\n}"
            }
          ]
        },
        {
          "name": "Delete Employee",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/employees/{{employeeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["employees", "{{employeeId}}"]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "DELETE",
                "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                "url": { "raw": "{{baseUrl}}/employees/2c6497a9-0855-4177-841c-189e8e271fb6", "host": ["{{baseUrl}}"], "path": ["employees", "2c6497a9-0855-4177-841c-189e8e271fb6"] }
              },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"id\": \"2c6497a9-0855-4177-841c-189e8e271fb6\",\n  \"name\": \"Temp Delete Me\",\n  \"age\": 25,\n  \"position\": \"Intern\",\n  \"salary\": \"3000000\",\n  \"createdAt\": \"2026-08-20T07:00:25.615Z\",\n  \"updatedAt\": \"2026-08-20T07:00:25.615Z\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "CSV Import",
      "item": [
        {
          "name": "Upload CSV",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 202) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('jobId', body.jobId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Pick backend/scripts/sample-employees.csv for a quick test (20 rows), or generate a large one first: `node scripts/generate-large-csv.mjs 25000` -> scripts/generated-employees.csv (25,000 rows, satisfies the brief's 20,000+ requirement)."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/csv-import/upload",
              "host": ["{{baseUrl}}"],
              "path": ["csv-import", "upload"]
            },
            "description": "Multipart upload (field name MUST be 'file'). The file is streamed straight to disk (never buffered fully in memory) and a BullMQ job is enqueued immediately; this endpoint returns 202 + {jobId} right away, before the import finishes. Poll 'Import Status' below or listen on GET /notifications/stream (`csv-import.progress` / `.completed` / `.failed` events) for real progress."
          },
          "response": [
            {
              "name": "202 Accepted",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "scripts/sample-employees.csv" }] },
                "url": { "raw": "{{baseUrl}}/csv-import/upload", "host": ["{{baseUrl}}"], "path": ["csv-import", "upload"] }
              },
              "status": "Accepted",
              "code": 202,
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"jobId\": \"2\"\n}"
            }
          ]
        },
        {
          "name": "Import Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/csv-import/{{jobId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["csv-import", "{{jobId}}", "status"]
            },
            "description": "Fallback for a client that missed the SSE events (e.g. page reload mid-import). `processed`/`total` are BYTES read (that's how `percent` is computed server-side, so a byte-count pre-pass isn't needed) -- `rowsProcessed` is the actual row count so far. `imported`/`skipped`/`errors` populate once the job reaches `completed`."
          },
          "response": [
            {
              "name": "200 OK (completed)",
              "originalRequest": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                "url": { "raw": "{{baseUrl}}/csv-import/2/status", "host": ["{{baseUrl}}"], "path": ["csv-import", "2", "status"] }
              },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"jobId\": \"2\",\n  \"state\": \"completed\",\n  \"processed\": 831,\n  \"total\": 831,\n  \"percent\": 100,\n  \"rowsProcessed\": 20,\n  \"imported\": 20,\n  \"skipped\": 0,\n  \"errors\": []\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "SSE Stream",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "text/event-stream" }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications/stream?token={{token}}",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "stream"],
              "query": [
                { "key": "token", "value": "{{token}}", "description": "Required. Browsers' native EventSource can't set an Authorization header, so this route accepts the JWT as a query param (in addition to a normal Authorization: Bearer header, which also works here -- e.g. for curl/Postman)." }
              ]
            },
            "description": "Server-Sent Events stream -- realtime push for `employee.created`, `csv-import.progress`, `csv-import.completed`, and `csv-import.failed`. Postman's request runner isn't a great SSE client; the most reliable manual test is:\n\n`curl -N \"{{baseUrl}}/notifications/stream?token=<your token>\"`\n\n(swap in the real value of {{token}}; Postman doesn't expand collection variables inside a raw shell command you copy out). Requires a valid token (query param or Authorization header) -- see docs/superpowers/AUDIT.md #4."
          },
          "response": [
            {
              "name": "401 Unauthorized (no/invalid token)",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": { "raw": "{{baseUrl}}/notifications/stream", "host": ["{{baseUrl}}"], "path": ["notifications", "stream"] }
              },
              "status": "Unauthorized",
              "code": 401,
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"statusCode\": 401,\n  \"message\": \"Unauthorized\"\n}"
            },
            {
              "name": "200 OK (example event stream body)",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": { "raw": "{{baseUrl}}/notifications/stream?token={{token}}", "host": ["{{baseUrl}}"], "path": ["notifications", "stream"], "query": [{ "key": "token", "value": "{{token}}" }] }
              },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "text/event-stream" }],
              "body": "event: employee.created\nid: 2026-08-20T06:46:18.425Z\ndata: {\"id\":\"6dab9229-6a51-4ecb-8926-14c4d2b05808\",\"name\":\"Siti Aminah\",\"age\":34,\"position\":\"QA Engineer\",\"salary\":\"11000000\",\"createdAt\":\"2026-08-20T06:46:18.112Z\",\"updatedAt\":\"2026-08-20T06:46:18.112Z\"}\n\nevent: csv-import.progress\nid: 2026-08-20T06:47:13.300Z\ndata: {\"jobId\":\"1\",\"processed\":831,\"total\":831,\"percent\":99,\"rowsProcessed\":20}\n\nevent: csv-import.completed\nid: 2026-08-20T06:47:13.301Z\ndata: {\"jobId\":\"1\",\"imported\":20,\"skipped\":0,\"errors\":[]}\n"
            }
          ]
        }
      ]
    }
  ]
}
