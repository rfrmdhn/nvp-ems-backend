# Copy this file to .env before running anything locally (docker compose reads .env
# automatically from this directory). See README.md for the full setup guide.

# ---- Postgres ----------------------------------------------------------------
POSTGRES_USER=ems
POSTGRES_PASSWORD=ems_password
POSTGRES_DB=ems
# Used by the app/migrate/seed processes. Inside docker-compose this points at the
# `postgres` service by its compose service name, not localhost.
DATABASE_URL=postgresql://ems:ems_password@postgres:5432/ems?schema=public
# If running the API/worker/prisma CLI directly on the host (not via `docker compose
# up`), e.g. `npm run start:dev` against a docker-compose-managed Postgres, use
# localhost instead: postgresql://ems:ems_password@localhost:5432/ems?schema=public

# ---- Redis ---------------------------------------------------------------------
# Inside docker-compose this is the `redis` service name; use `localhost` for
# host-side (non-Docker) processes talking to a docker-compose-managed Redis.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Auth / JWT ------------------------------------------------------------------
# Change this to a long random string in any real deployment.
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=1h

# ---- Seeded admin (used by prisma/seed.ts, idempotent upsert on email) -----------
ADMIN_EMAIL=admin@nusantaradigital.test
# Example password only — change before any non-local use.
ADMIN_PASSWORD=ChangeMe123!

# ---- API process -----------------------------------------------------------------
PORT=3000
# Origin the frontend is served from, for CORS. Comma-separate multiple origins.
CORS_ORIGIN=http://localhost:5173
